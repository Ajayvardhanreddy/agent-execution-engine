# ─── Required ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# ─── Memory Service (Layer 2) ─────────────────────────────────────────────────
MEMORY_SERVICE_URL=http://localhost:8080

# ─── KV Store (Layer 1) ───────────────────────────────────────────────────────
KV_STORE_NODES=http://localhost:8000,http://localhost:8001,http://localhost:8002

# ─── Engine API ───────────────────────────────────────────────────────────────
ENGINE_API_PORT=9000

# ─── Logging ──────────────────────────────────────────────────────────────────
# Options: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ─── Models ───────────────────────────────────────────────────────────────────
# Production demos
PRODUCTION_MODEL=claude-sonnet-4-6
# Eval runs (cost-controlled)
EVAL_MODEL=claude-haiku-4-5-20251001

# ─── Concurrency & Retention ──────────────────────────────────────────────────
MAX_CONCURRENT_RUNS=10
TRACE_RETENTION_DAYS=30
